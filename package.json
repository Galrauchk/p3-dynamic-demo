    "@fontsource/inter": "^5.2.8",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "smol-toml": "1.9.0",
    "wrangler": "4.143.0"
  },
  "cloudflare": {
    "domaine": "p3-dynamic-demo.netlify.app"
  }
}
