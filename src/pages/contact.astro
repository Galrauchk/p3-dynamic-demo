---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contactez Spark Digital Agency à Montpellier — 04 67 22 33 44 — hello@spark-digital.fr. Audit digital gratuit, réponse sous 24h."
  page="contact"
>

  <section class="page-hero particles-section" style="padding:9rem 0 5rem;">
    <div class="particles-canvas" aria-hidden="true"></div>
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Accueil</a><span class="breadcrumb-sep">/</span>
        <span>Contact</span>
      </div>
      <span class="section-label">Parlons de votre projet</span>
      <h1>Prêt à <span class="gradient-text">performer</span> ?</h1>
      <p>Remplissez le formulaire, appelez-nous ou envoyez un email. Nos experts vous répondent sous 24h avec un plan d'action adapté à vos objectifs.</p>
    </div>
  </section>

  <!-- Contact form + Info -->
  <section class="section section-dark">
    <div class="container">
      <div class="split animate-up">

        <!-- Formulaire -->
        <div class="glass-card" style="padding:2.5rem;">
          <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:.5rem;">Décrivez votre projet</h2>
          <p class="text-muted" style="font-size:.875rem;margin-bottom:2rem;">Audit gratuit · Réponse sous 24h · Sans engagement</p>

          <form action="#" method="post" novalidate>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem;">
              <div class="form-row">
                <label class="form-label">Prénom *</label>
                <input type="text" name="prenom" class="form-input" placeholder="Julien" required />
              </div>
              <div class="form-row">
                <label class="form-label">Nom *</label>
                <input type="text" name="nom" class="form-input" placeholder="Dupont" required />
              </div>
            </div>

            <div class="form-row">
              <label class="form-label">Email professionnel *</label>
              <input type="email" name="email" class="form-input" placeholder="julien@entreprise.fr" required />
            </div>

            <div class="form-row">
              <label class="form-label">Téléphone</label>
              <input type="tel" name="tel" class="form-input" placeholder="06 12 34 56 78" />
            </div>

            <div class="form-row">
              <label class="form-label">Entreprise / Site web</label>
              <input type="text" name="entreprise" class="form-input" placeholder="Mon Entreprise / www.monsite.fr" />
            </div>

            <div class="form-row">
              <label class="form-label">Service souhaité</label>
              <select name="service" class="form-input">
                <option value="">Choisissez un service...</option>
                <option>SEO & Référencement</option>
                <option>Google Ads</option>
                <option>Social Media</option>
                <option>Création Web</option>
                <option>Marketing Automation</option>
                <option>Stratégie digitale complète</option>
              </select>
            </div>

            <div class="form-row">
              <label class="form-label">Budget mensuel estimé</label>
              <select name="budget" class="form-input">
                <option value="">Sélectionner...</option>
                <option>Moins de 1 000€/mois</option>
                <option>1 000€ – 3 000€/mois</option>
                <option>3 000€ – 5 000€/mois</option>
                <option>5 000€ – 10 000€/mois</option>
                <option>Plus de 10 000€/mois</option>
              </select>
            </div>

            <div class="form-row">
              <label class="form-label">Message</label>
              <textarea name="message" class="form-input" placeholder="Décrivez votre projet, vos objectifs, votre situation actuelle..." style="min-height:120px;"></textarea>
            </div>

            <button type="submit" class="btn-primary" style="width:100%;justify-content:center;padding:1rem;font-size:1rem;">
              Envoyer ma demande →
            </button>
            <p class="text-muted" style="font-size:.75rem;text-align:center;margin-top:1rem;">
              🔒 Vos données sont sécurisées et ne seront jamais partagées.
            </p>
          </form>
        </div>

        <!-- Infos contact -->
        <div>
          <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:1.75rem;">Autres façons de nous joindre</h2>

          <div class="glass-card" style="padding:1.5rem;margin-bottom:1rem;display:flex;align-items:center;gap:1.25rem;">
            <div style="width:52px;height:52px;border-radius:14px;background:var(--cyan-dim);border:1px solid rgba(0,229,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">📞</div>
            <div>
              <div style="font-size:.75rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Téléphone</div>
              <a href="tel:0467223344" style="font-size:1.25rem;font-weight:700;color:var(--cyan);">04 67 22 33 44</a>
              <div class="text-muted" style="font-size:.8rem;">Lun–Ven, 9h–18h</div>
            </div>
          </div>

          <div class="glass-card" style="padding:1.5rem;margin-bottom:1rem;display:flex;align-items:center;gap:1.25rem;">
            <div style="width:52px;height:52px;border-radius:14px;background:var(--cyan-dim);border:1px solid rgba(0,229,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">✉️</div>
            <div>
              <div style="font-size:.75rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Email</div>
              <a href="/contact" style="font-size:1.1rem;font-weight:700;color:var(--cyan);">hello@spark-digital.fr</a>
              <div class="text-muted" style="font-size:.8rem;">Réponse sous 24h garantie</div>
            </div>
          </div>

          <div class="glass-card" style="padding:1.5rem;margin-bottom:2rem;display:flex;align-items:center;gap:1.25rem;">
            <div style="width:52px;height:52px;border-radius:14px;background:var(--cyan-dim);border:1px solid rgba(0,229,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">📍</div>
            <div>
              <div style="font-size:.75rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem;">Bureaux</div>
              <div style="font-weight:600;margin-bottom:.25rem;">Montpellier (Siège)</div>
              <div class="text-muted" style="font-size:.875rem;">+ Toulouse · Bordeaux</div>
            </div>
          </div>

          <!-- Garanties -->
          <div style="padding:1.5rem;background:rgba(0,229,255,.06);border:1px solid rgba(0,229,255,.15);border-radius:16px;">
            <h3 style="font-weight:700;margin-bottom:1rem;font-size:.95rem;">✅ Notre engagement</h3>
            <ul class="check-list">
              <li>Réponse sous 24h ouvrées garantie</li>
              <li>Audit digital gratuit et sans engagement</li>
              <li>Devis transparent en 48h</li>
              <li>Pas de contrat longue durée imposé</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ rapide -->
  <section class="section section-white diagonal-up">
    <div class="container" style="max-width:700px;">
      <div class="text-center mb-xl">
        <span class="section-label section-label-dark">FAQ</span>
        <h2 style="font-size:clamp(1.75rem,4vw,2.25rem);font-weight:800;">Questions fréquentes</h2>
      </div>
      {[
        { q:'Quels sont vos délais pour démarrer ?', a:'En général, nous pouvons démarrer une mission dans les 5 à 10 jours suivant la signature du devis. Pour les projets web, comptez 2 à 3 semaines de brief et cadrage avant le début de la production.' },
        { q:'Proposez-vous des audits gratuits ?', a:'Oui, absolument. Nous proposons un audit digital gratuit (SEO, Ads ou Social) d\'environ 30 minutes pour tous les nouveaux prospects. C\'est sans engagement et cela vous donne déjà des actions concrètes à mener.' },
        { q:'Intervenez-vous sur toute la France ?', a:'Principalement dans le Sud (Montpellier, Toulouse, Bordeaux), mais nos clients sont partout en France et en Europe. Nous travaillons à 100% en remote avec les mêmes résultats.' },
        { q:'Combien coûtent vos prestations ?', a:'Nos prestations commencent à partir de 990€/mois pour le SEO et 500€/mois de setup pour les Ads. Chaque projet est devisé sur-mesure selon vos objectifs et votre budget.' },
      ].map(item => (
        <div class="faq-item">
          <button class="faq-q">
            {item.q}
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
