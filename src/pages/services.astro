---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nos Services"
  description="Découvrez tous les services de Spark Digital Agency : SEO, Google Ads, Social Media, Création Web et Marketing Automation à Montpellier."
  page="services"
>

  <!-- Page Hero -->
  <section class="page-hero particles-section">
    <div class="particles-canvas" aria-hidden="true"></div>
    <div class="page-hero-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Accueil</a>
        <span class="breadcrumb-sep">/</span>
        <span>Services</span>
      </div>
      <span class="section-label">Ce que nous faisons</span>
      <h1>Nos <span class="gradient-text">services digitaux</span></h1>
      <p>Du SEO à l'automation marketing, nous proposons l'ensemble des leviers pour accélérer votre croissance en ligne. Chaque stratégie est construite sur-mesure, pilotée par la data.</p>
    </div>
  </section>

  <!-- Services détaillés — dark -->
  <section class="section section-dark">
    <div class="container">

      <!-- SEO -->
      <div class="split animate-up" style="margin-bottom:5rem;">
        <div>
          <span class="section-label">Levier 01</span>
          <h2 style="font-size:2rem;font-weight:800;margin-bottom:1rem;">SEO & Référencement naturel</h2>
          <p class="text-muted" style="margin-bottom:1.5rem;line-height:1.75;">
            Être visible sur Google n'est pas optionnel. Notre approche SEO combine audit technique approfondi, stratégie de contenu et link building premium pour vous propulser en première page.
          </p>
          <ul class="check-list" style="margin-bottom:2rem;">
            <li>Audit SEO technique complet (Core Web Vitals, crawl, index)</li>
            <li>Recherche de mots-clés & mapping sémantique</li>
            <li>Rédaction SEO et optimisation on-page</li>
            <li>Netlinking & Digital PR</li>
            <li>Suivi des positions et rapports mensuels</li>
          </ul>
          <a href="/seo" class="btn-primary">Découvrir le SEO →</a>
        </div>
        <div class="glass-card" style="padding:2.5rem;text-align:center;">
          <div style="font-size:5rem;margin-bottom:1rem;">🔍</div>
          <div style="font-size:2.5rem;font-weight:800;background:var(--gradient);background-size:200%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">+340%</div>
          <p class="text-muted" style="margin-bottom:1.5rem;">de trafic organique moyen</p>
          <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:1.25rem;">
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;">
              <span style="font-size:.8rem;color:var(--text-muted);">Position moyenne</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">3.2</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;">
              <span style="font-size:.8rem;color:var(--text-muted);">CTR moyen</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">8.4%</span>
            </div>
            <div style="display:flex;justify-content:space-between;">
              <span style="font-size:.8rem;color:var(--text-muted);">Mots-clés top 3</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">120+</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Google Ads -->
      <div class="split animate-up" style="margin-bottom:5rem;">
        <div class="glass-card" style="padding:2.5rem;text-align:center;order:1;">
          <div style="font-size:5rem;margin-bottom:1rem;">📢</div>
          <div style="font-size:2.5rem;font-weight:800;background:var(--gradient);background-size:200%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">-40%</div>
          <p class="text-muted" style="margin-bottom:1.5rem;">de coût par acquisition</p>
          <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:1.25rem;">
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;">
              <span style="font-size:.8rem;color:var(--text-muted);">ROAS moyen</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">6.8x</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;">
              <span style="font-size:.8rem;color:var(--text-muted);">Taux de conversion</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">4.2%</span>
            </div>
            <div style="display:flex;justify-content:space-between;">
              <span style="font-size:.8rem;color:var(--text-muted);">CPC optimisé</span>
              <span style="font-size:.8rem;font-weight:700;color:var(--cyan);">-38%</span>
            </div>
          </div>
        </div>
        <div style="order:2;">
          <span class="section-label">Levier 02</span>
          <h2 style="font-size:2rem;font-weight:800;margin-bottom:1rem;">Google Ads & SEA</h2>
          <p class="text-muted" style="margin-bottom:1.5rem;line-height:1.75;">
            Captez vos prospects au moment précis où ils cherchent vos services. Nos experts Google Ads Certified créent et optimisent vos campagnes pour un ROI maximal.
          </p>
          <ul class="check-list" style="margin-bottom:2rem;">
            <li>Audit de vos campagnes existantes</li>
            <li>Search, Display, Shopping, Remarketing, YouTube</li>
            <li>Optimisation du Quality Score et des enchères</li>
            <li>A/B testing des annonces et landing pages</li>
            <li>Reporting transparent avec attribution multi-touch</li>
          </ul>
          <a href="/google-ads" class="btn-primary">Découvrir Google Ads →</a>
        </div>
      </div>

      <!-- Social Media + Creation web -->
      <div class="g-2 animate-up" style="margin-bottom:3rem;">
        <div class="glass-card" style="padding:2rem;">
          <div class="icon-box">📱</div>
          <h3 style="font-weight:700;margin-bottom:.75rem;">Social Media</h3>
          <p class="text-muted" style="font-size:.9rem;line-height:1.65;margin-bottom:1.5rem;">
            Stratégie éditoriale, création de contenus, community management, et publicités Meta & TikTok. On transforme vos réseaux en véritables moteurs de croissance.
          </p>
          <a href="/social-media" class="btn-outline-cyan">En savoir plus</a>
        </div>
        <div class="glass-card" style="padding:2rem;">
          <div class="icon-box">💻</div>
          <h3 style="font-weight:700;margin-bottom:.75rem;">Création Web</h3>
          <p class="text-muted" style="font-size:.9rem;line-height:1.65;margin-bottom:1.5rem;">
            Sites vitrine, e-commerce, landing pages haute conversion. Design premium, performances techniques irréprochables, UX centrée conversion.
          </p>
          <a href="/creation-web" class="btn-outline-cyan">En savoir plus</a>
        </div>
      </div>

      <!-- Automation -->
      <div class="glass-card animate-up" style="padding:2.5rem;background:linear-gradient(135deg,rgba(0,229,255,0.06),rgba(0,102,255,0.06));">
        <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
          <div style="font-size:4rem;">🤖</div>
          <div style="flex:1;min-width:280px;">
            <span class="section-label">Levier 05</span>
            <h3 style="font-size:1.5rem;font-weight:800;margin-bottom:.75rem;">Marketing Automation</h3>
            <p class="text-muted" style="line-height:1.7;margin-bottom:1.5rem;">
              Email sequences, lead nurturing, CRM automation, chatbots. Vos prospects sont qualifiés et accompagnés 24h/24 sans effort manuel de votre côté.
            </p>
            <a href="/automation" class="btn-primary">Découvrir l'automation →</a>
          </div>
          <div style="text-align:center;">
            <div style="font-size:2.5rem;font-weight:800;color:var(--cyan);">+65%</div>
            <div class="text-muted" style="font-size:.85rem;">leads qualifiés</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Pourquoi nous — blanc -->
  <section class="section section-white diagonal-up">
    <div class="container">
      <div class="text-center mb-xl">
        <span class="section-label section-label-dark">Pourquoi Spark Digital ?</span>
        <h2 style="font-size:clamp(2rem,4vw,2.5rem);font-weight:800;letter-spacing:-.02em;">
          L'agence qui s'engage sur les résultats
        </h2>
      </div>
      <div class="g-4">
        {[
          { icon:'📊', title:'Data-driven', desc:'Chaque décision repose sur des données réelles, pas des intuitions.' },
          { icon:'⚡', title:'Réactivité', desc:'Interlocuteur dédié, réponse sous 4h, reporting en temps réel.' },
          { icon:'🎯', title:'Expertise certifiée', desc:'Google Certified, Meta Blueprint, HubSpot Academy.' },
          { icon:'🤝', title:'Partenariat long terme', desc:'Nous construisons avec vous, pas pour vous. Vos objectifs sont les nôtres.' },
        ].map((item, i) => (
          <div class={`light-card animate-up delay-${i+1}`} style="padding:2rem;text-align:center;">
            <div style="font-size:2.5rem;margin-bottom:1rem;">{item.icon}</div>
            <h3 style="font-size:1rem;font-weight:700;margin-bottom:.5rem;">{item.title}</h3>
            <p class="text-muted" style="font-size:.875rem;line-height:1.65;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container text-center">
      <span class="section-label">Démarrons</span>
      <h2 style="font-size:clamp(2rem,4vw,2.75rem);font-weight:800;margin-bottom:1rem;">
        Quel service vous convient le mieux ?
      </h2>
      <p class="text-muted" style="max-width:480px;margin:0 auto 2rem;">
        Nos experts vous aident à identifier les leviers prioritaires pour votre activité.
      </p>
      <a href="/devis" class="btn-primary" style="font-size:1rem;padding:1rem 2.25rem;">Audit gratuit en 24h →</a>
    </div>
  </section>

</BaseLayout>
