---
import LegalLinks from './LegalLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">

    <div class="footer-grid">

      <!-- Col 1 : Brand -->
      <div>
        <div class="footer-logo-wrap">
          <span class="footer-logo-spark">Spark</span><span class="footer-logo-digital">&nbsp;Digital</span>
        </div>
        <p class="footer-tagline">"On crée, on mesure, on performe"</p>
        <p class="footer-desc">
          Agence marketing digital basée à Montpellier. Nous aidons les entreprises ambitieuses à accélérer leur croissance en ligne grâce au SEO, Google Ads, Social Media et à la création web.
        </p>
        <div class="footer-social">
          <a href="#" class="social-btn" aria-label="LinkedIn">in</a>
          <a href="#" class="social-btn" aria-label="Twitter">𝕏</a>
          <a href="#" class="social-btn" aria-label="Instagram">ig</a>
          <a href="#" class="social-btn" aria-label="YouTube">▶</a>
        </div>
        <div class="footer-cities" style="margin-top:1.25rem;">
          <span class="footer-city">Montpellier</span>
          <span class="footer-city">Toulouse</span>
          <span class="footer-city">Bordeaux</span>
        </div>
      </div>

      <!-- Col 2 : Services -->
      <div>
        <p class="footer-col-title">Services</p>
        <ul class="footer-links">
          <li><a href="/seo">SEO & Référencement</a></li>
          <li><a href="/google-ads">Google Ads</a></li>
          <li><a href="/social-media">Social Media</a></li>
          <li><a href="/creation-web">Création Web</a></li>
          <li><a href="/automation">Marketing Automation</a></li>
          <li><a href="/devis">Devis gratuit</a></li>
        </ul>
      </div>

      <!-- Col 3 : Agence -->
      <div>
        <p class="footer-col-title">Agence</p>
        <ul class="footer-links">
          <li><a href="/about">À propos</a></li>
          <li><a href="/equipe">Notre équipe</a></li>
          <li><a href="/realisations">Réalisations</a></li>
          <li><a href="/blog">Blog & Actus</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Col 4 : Contact -->
      <div>
        <p class="footer-col-title">Contact</p>
        <div class="footer-contact-item">
          <span class="footer-contact-icon">📞</span>
          <span><a href="tel:0467223344" style="color:var(--text-muted);transition:color .2s;" onmouseover="this.style.color='var(--cyan)'" onmouseout="this.style.color='var(--text-muted)'">04 67 22 33 44</a></span>
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-icon">✉️</span>
          <span><a href="/contact" style="color:var(--text-muted);transition:color .2s;" onmouseover="this.style.color='var(--cyan)'" onmouseout="this.style.color='var(--text-muted)'">hello@spark-digital.fr</a></span>
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-icon">📍</span>
          <span>Montpellier, 34000</span>
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-icon">⏰</span>
          <span>Lun–Ven : 9h–18h</span>
        </div>
        <div style="margin-top:1.5rem;">
          <a href="/devis" class="btn-outline-cyan" style="font-size:.85rem;padding:.6rem 1.25rem;">
            Audit gratuit →
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <span>© {year} Spark Digital Agency — Tous droits réservés</span>
      <div class="footer-bottom-links">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
      <LegalLinks includeMentions={false} />
    </div>

  </div>
</footer>
